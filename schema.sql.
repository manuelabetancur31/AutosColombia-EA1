-- Tabla de Usuarios (Gestión de Operadores y Admins)
CREATE TABLE usuario (
    id_usuario SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    usuario VARCHAR(50) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    rol VARCHAR(20) DEFAULT 'Operador' CHECK (rol IN ('Operador', 'Administrador')),
    estado VARCHAR(10) DEFAULT 'Activo' CHECK (estado IN ('Activo', 'Inactivo'))
);

-- Tabla de Celdas (70 carros y 10 motos)
CREATE TABLE celda (
    id_celda VARCHAR(10) PRIMARY KEY,
    tipo_vehiculo VARCHAR(10) CHECK (tipo_vehiculo IN ('Carro', 'Moto')),
    estado VARCHAR(15) DEFAULT 'Disponible' CHECK (estado IN ('Disponible', 'Ocupado', 'Mantenimiento'))
);

-- Tabla de Vehículos
CREATE TABLE vehiculo (
    placa VARCHAR(10) PRIMARY KEY,
    tipo_vehiculo VARCHAR(10) CHECK (tipo_vehiculo IN ('Carro', 'Moto'))
);

-- Tabla de Suscripciones Mensuales (Datos para comprobar vigencia)
CREATE TABLE suscripcion_mensual (
    id_suscripcion SERIAL PRIMARY KEY,
    placa VARCHAR(10) REFERENCES vehiculo(placa),
    nombre_propietario VARCHAR(100) NOT NULL,
    fecha_inicio DATE NOT NULL,
    fecha_vencimiento DATE NOT NULL,
    estado_pago VARCHAR(15) DEFAULT 'Vigente' CHECK (estado_pago IN ('Vigente', 'Vencido'))
);

-- Tabla de Registro de Acceso (Validación realizada al ingresar)
CREATE TABLE registro_acceso (
    id_registro SERIAL PRIMARY KEY,
    placa VARCHAR(10) REFERENCES vehiculo(placa),
    id_celda VARCHAR(10) REFERENCES celda(id_celda),
    id_usuario_entrada INT REFERENCES usuario(id_usuario),
    id_usuario_salida INT REFERENCES usuario(id_usuario),
    fecha_hora_entrada TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_hora_salida TIMESTAMP NULL,
    tipo_cliente VARCHAR(15) CHECK (tipo_cliente IN ('Ocasional', 'Mensual')),
    total_pagado DECIMAL(10,2) DEFAULT 0.00,
    estado_acceso VARCHAR(15) DEFAULT 'Activo' CHECK (estado_acceso IN ('Activo', 'Finalizado'))
);
 
